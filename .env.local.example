# Resend — https://resend.com
# Copy this file to .env.local and fill in real values (never commit .env.local)

# API key with "Sending access" from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Audience ID from resend.com → Audiences → "Velovia Waitlist"
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Verified sender address (must be on a domain verified in Resend)
RESEND_FROM_EMAIL=hello@velovia.bg
